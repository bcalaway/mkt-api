  "info": {
    "description": "The market data platform's API: Treasury CMT yields, curves, spreads and the security master. Instruments by short name; values as decimal strings.",
    "title": "mkt-api",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/bars": {
      "get": {
        "description": "Bars for a chart: its series at one interval, one fixed block at a time (app/blocks.py).\n\nA series is an instrument (`UST-10Y-CMT`: its yield), `spread(LONG,SHORT)` (long minus short) or\n`fly(WING,BODY,WING)` (2 x body minus both wings). Values are decimals (\"0.041\", \"0.0052\"), each with a\n`_display` form in the series' `unit` (percent for a yield, basis points for a spread or fly). Blocks are a year of days or a decade of weeks or months, so a\nscreenful is a handful of requests and the same block is always the same URL: a finished\nblock (`final`) is cached by the browser for a day. `source` (UST-PAR, H15-TCM) narrows yields to one\npublisher. All arithmetic is Decimal; values are strings.",
        "operationId": "getBars",
        "parameters": [
          {
            "in": "query",
            "name": "series",
            "required": true,
            "schema": {
              "items": {
                "type": "string"
              },
              "maxItems": 14,
              "minItems": 1,
              "title": "Series",
              "type": "array"
            }
          },
          {
            "in": "query",
            "name": "interval",
            "required": true,
            "schema": {
              "enum": [
                "day",
                "week",
                "month",
                "quarter",
                "year"
              ],
              "title": "Interval",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "block",
            "required": true,
            "schema": {
              "title": "Block",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "source",
            "required": false,
            "schema": {
              "default": "",
              "title": "Source",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BarsResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Bars"
      }
    },
    "/api/curve": {
      "get": {
        "description": "The curve on a date (default: the latest), plus the same curve `compare` before it (1W, 1M, 1Y).\n\nEach uses the last business day on or before its date that has values.",
        "operationId": "getCurves",
        "parameters": [
          {
            "in": "query",
            "name": "date",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Date"
            }
          },
          {
            "in": "query",
            "name": "compare",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "items": {
                    "type": "string"
                  },
                  "maxItems": 6,
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Compare"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurveResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Curve"
      }
    },
    "/api/events": {
      "get": {
        "description": "What a chart of these series should mark: the security master's notes on their instruments (first\npublished, where H.15 starts, gaps, method changes), over all of history. A note on several instruments\n(the 2021 method change is on every CMT) comes once, naming them all. Series as for /api/bars.",
        "operationId": "getEvents",
        "parameters": [
          {
            "in": "query",
            "name": "series",
            "required": true,
            "schema": {
              "items": {
                "type": "string"
              },
              "maxItems": 14,
              "minItems": 1,
              "title": "Series",
              "type": "array"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventsResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Events"
      }
    },
    "/api/instruments": {
      "get": {
        "description": "Every instrument, or those of one type (`cmt_yield` for the curve's tenors); shortest tenor first.\n\nThere are thousands of Treasury securities, so a screen that wants the tenors asks for `type=cmt_yield`.",
        "operationId": "listInstruments",
        "parameters": [
          {
            "in": "query",
            "name": "type",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 40,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Type"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/InstrumentSummary"
                  },
                  "title": "Response Listinstruments",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Instruments"
      }
    },
    "/api/instruments/{name}": {
      "get": {
        "description": "One instrument by short name or alias, with its identifiers, notes and latest golden value.",
        "operationId": "getInstrument",
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "title": "Name",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InstrumentDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Instrument"
      }
    },
    "/api/search": {
      "get": {
        "description": "Instruments whose name, alias, identifier or description contains q.",
        "operationId": "searchInstruments",
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "required": true,
            "schema": {
              "maxLength": 60,
              "minLength": 1,
              "title": "Q",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/InstrumentSummary"
                  },
                  "title": "Response Searchinstruments",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Search"
      }
    },
    "/api/securities": {
      "get": {
        "description": "Treasury securities by maturity: outstanding ones, or all since 1980 with `include_inactive`.\n\nWith their CUSIP, coupon, dates, on-the-run aliases (today) and, for outstanding ones, the latest\nFedInvest end-of-day price.",
        "operationId": "listSecurities",
        "parameters": [
          {
            "in": "query",
            "name": "type",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "bill",
                    "note",
                    "bond",
                    "tips",
                    "frn"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Type"
            }
          },
          {
            "in": "query",
            "name": "include_inactive",
            "required": false,
            "schema": {
              "default": false,
              "title": "Include Inactive",
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "maturing_from",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Maturing From"
            }
          },
          {
            "in": "query",
            "name": "maturing_to",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Maturing To"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 1000,
              "maximum": 6000,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SecurityListResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Securities"
      }
    },
    "/api/securities/{name}": {
      "get": {
        "description": "One Treasury security by short name, alias, CUSIP or on-the-run name: terms with where each came from,\nevery auction, identifiers, on-the-run aliases, a TIPS's index ratio today, and the latest price.",
        "operationId": "getSecurity",
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "title": "Name",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SecurityDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Security"
      }
    }
  }
}
