  "info": {
    "description": "The market data platform's API: Treasury CMT yields, curves, spreads and the security master. Instruments by short name; values as decimal strings.",
    "title": "mkt-api",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/bars": {
      "get": {
        "description": "Bars for a chart: its series at one interval, one fixed block at a time (app/blocks.py).\n\nA series is an instrument (`UST-10Y-CMT`: its yield in percent), `spread(LONG,SHORT)` or\n`fly(WING,BODY,WING)` (basis points). Blocks are a year of days or a decade of weeks or months, so a\nscreenful is a handful of requests and the same block is always the same URL: a finished\nblock (`final`) is cached by the browser for a day. `source` (UST-PAR, H15-TCM) narrows yields to one\npublisher. All arithmetic is Decimal; values are strings.",
        "operationId": "getBars",
        "parameters": [
          {
            "in": "query",
            "name": "series",
            "required": true,
            "schema": {
              "items": {
                "type": "string"
              },
              "maxItems": 14,
              "minItems": 1,
              "title": "Series",
              "type": "array"
            }
          },
          {
            "in": "query",
            "name": "interval",
            "required": true,
            "schema": {
              "enum": [
                "day",
                "week",
                "month",
                "quarter",
                "year"
              ],
              "title": "Interval",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "block",
            "required": true,
            "schema": {
              "title": "Block",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "source",
            "required": false,
            "schema": {
              "default": "",
              "title": "Source",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BarsResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Bars"
      }
    },
    "/api/curve": {
      "get": {
        "description": "The curve on a date (default: the latest), plus the same curve `compare` before it (1W, 1M, 1Y).\n\nEach uses the last business day on or before its date that has values.",
        "operationId": "getCurves",
        "parameters": [
          {
            "in": "query",
            "name": "date",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Date"
            }
          },
          {
            "in": "query",
            "name": "compare",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "items": {
                    "type": "string"
                  },
                  "maxItems": 6,
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Compare"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurveResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Curve"
      }
    },
    "/api/events": {
      "get": {
        "description": "What a chart of these series should mark: the security master's notes on their instruments (first\npublished, where H.15 starts, gaps, method changes), over all of history. A note on several instruments\n(the 2021 method change is on every CMT) comes once, naming them all. Series as for /api/bars.",
        "operationId": "getEvents",
        "parameters": [
          {
            "in": "query",
            "name": "series",
            "required": true,
            "schema": {
              "items": {
                "type": "string"
              },
              "maxItems": 14,
              "minItems": 1,
              "title": "Series",
              "type": "array"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventsResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Events"
      }
    },
    "/api/instruments": {
      "get": {
        "description": "Every instrument, shortest tenor first.",
        "operationId": "listInstruments",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/InstrumentSummary"
                  },
                  "title": "Response Listinstruments",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Instruments"
      }
    },
    "/api/instruments/{name}": {
      "get": {
        "description": "One instrument by short name or alias, with its identifiers, notes and latest golden value.",
        "operationId": "getInstrument",
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "title": "Name",
              "type": "string"
            }
          }
        ],
        "responses": {
